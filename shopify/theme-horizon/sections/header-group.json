{
  "type": "header",
  "name": "En-tête",
  "sections": {
    "announcements": {
      "type": "header-announcements",
      "settings": {
        "speed": 5,
        "section_width": "page-width",
        "background_color": "#17301F",
        "divider_width": 0,
        "padding-block-start": 10,
        "padding-block-end": 10
      },
      "blocks": {
        "a1": {
          "type": "_announcement",
          "settings": {
            "text": "Livraison offerte dès 110 € en France",
            "link": "shopify://pages/livraison-et-retours",
            "font": "var(--font-subheading--family)",
            "font_size": "0.75rem",
            "letter_spacing": "loose",
            "case": "uppercase",
            "text_color": "#F6F1E6"
          }
        },
        "a2": {
          "type": "_announcement",
          "settings": {
            "text": "Expédié depuis Lyon sous 2 jours · Mondial Relay",
            "font": "var(--font-subheading--family)",
            "font_size": "0.75rem",
            "letter_spacing": "loose",
            "case": "uppercase",
            "text_color": "#F6F1E6"
          }
        }
      },
      "block_order": [
        "a1",
        "a2"
      ]
    },
    "header_section": {
      "type": "header",
      "settings": {
        "logo_position": "center",
        "menu_position": "left",
        "menu_row": "top",
        "show_search": true,
        "search_position": "right",
        "search_row": "top",
        "show_country": false,
        "show_language": false,
        "section_width": "page-width",
        "section_height": "standard",
        "enable_sticky_header": "always",
        "divider_width": 1,
        "divider_size": "full-width",
        "border_width": 0,
        "enable_transparent_header_home": false,
        "enable_transparent_header_product": false,
        "enable_transparent_header_collection": false
      },
      "blocks": {
        "header-logo": {
          "type": "_header-logo",
          "static": true,
          "settings": {
            "hide_logo_on_home_page": false
          }
        },
        "header-menu": {
          "type": "_header-menu",
          "static": true,
          "settings": {
            "menu": "main-menu",
            "type_font_primary_size": "0.875rem",
            "menu_font_style": "regular",
            "type_font_primary_link": "heading",
            "type_case_primary_link": "none",
            "menu_style": "featured_products",
            "navigation_bar": false
          }
        }
      }
    }
  },
  "order": [
    "announcements",
    "header_section"
  ]
}