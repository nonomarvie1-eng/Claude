<div class="w ctr">
  <span class="lbl">Bientôt</span>
  <h1>{{ shop.name }}</h1>
  {%- if shop.password_message != blank %}<p>{{ shop.password_message }}</p>{% endif -%}
  {%- form 'storefront_password' -%}
    {{ form.errors | default_errors }}
    <div class="fs" style="max-width:360px;margin:0 auto">
      <input type="password" name="password" placeholder="Mot de passe" aria-label="Mot de passe" style="width:100%;padding:12px;border:1.5px solid var(--line);border-radius:4px">
    </div>
    <button class="btn" type="submit">Entrer</button>
  {%- endform -%}
</div>

{% schema %}
{ "name": "Mot de passe", "settings": [] }
{% endschema %}
