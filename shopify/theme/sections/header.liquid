{%- liquid
  assign menu = linklists[section.settings.menu]
  assign shop_url = routes.all_products_collection_url
-%}
<header class="hd">
  <div class="w bar">
    <button class="mb" id="mb" type="button" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mn">{% render 'icon', name: 'menu' %}</button>
    <nav class="dn" aria-label="Navigation">
      {%- if menu.links.size > 0 -%}
        {%- for l in menu.links -%}<a href="{{ l.url }}"{% if l.active or l.child_active %} class="on" aria-current="page"{% endif %}>{{ l.title }}</a>{%- endfor -%}
      {%- else -%}
        <a href="{{ routes.root_url }}"{% if request.page_type == 'index' %} class="on"{% endif %}>Accueil</a><a href="{{ shop_url }}"{% if request.page_type == 'collection' or request.page_type == 'product' %} class="on"{% endif %}>Boutique</a><a href="/pages/a-propos">À propos</a>{% if section.settings.contact_url != blank %}<a href="{{ section.settings.contact_url }}" target="_blank" rel="noopener">Contact</a>{% endif %}
      {%- endif -%}
    </nav>
    <a class="lg" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} – accueil">
      {%- if section.settings.logo -%}
        {{ section.settings.logo | image_url: width: 400 | image_tag: alt: shop.name }}
      {%- else -%}
        <span class="sc">{{ section.settings.logo_top }}</span><b>{{ section.settings.logo_main }}</b><i>{{ section.settings.logo_tagline }}</i>
      {%- endif -%}
    </a>
    <a class="cb" id="cb" href="{{ routes.cart_url }}" aria-label="Ouvrir le panier">{% render 'icon', name: 'cart' %}<span class="cn" id="cn">{{ cart.item_count }}</span></a>
  </div>
  <nav class="mnav" id="mn" aria-label="Menu mobile">
    {%- if menu.links.size > 0 -%}
      {%- for l in menu.links -%}<a href="{{ l.url }}">{{ l.title }}</a>{%- endfor -%}
    {%- else -%}
      <a href="{{ routes.root_url }}">Accueil</a><a href="{{ shop_url }}">Boutique</a><a href="/pages/a-propos">À propos</a>{% if section.settings.contact_url != blank %}<a href="{{ section.settings.contact_url }}" target="_blank" rel="noopener">Contact</a>{% endif %}
    {%- endif -%}
  </nav>
</header>

{% schema %}
{
  "name": "En-tête",
  "class": "section-header",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu", "info": "Sans menu, les liens Accueil, Boutique, À propos et Contact sont affichés." },
    { "type": "url", "id": "contact_url", "label": "Lien Contact (si pas de menu)", "default": "https://linktr.ee/marviejustine121" },
    { "type": "image_picker", "id": "logo", "label": "Logo (image)", "info": "Laisser vide pour le logo texte du site." },
    { "type": "text", "id": "logo_top", "label": "Logo : ligne manuscrite", "default": "La Boutique de" },
    { "type": "text", "id": "logo_main", "label": "Logo : nom", "default": "Mme Fofana" },
    { "type": "text", "id": "logo_tagline", "label": "Logo : slogan", "default": "Traditions, créations & art de vivre" }
  ]
}
{% endschema %}
