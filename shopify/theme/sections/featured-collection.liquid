{%- liquid
  assign col = section.settings.collection
  if col == blank
    assign col = collections.all
  endif
-%}
<section class="sec sel">
  <div class="w">
    <div class="sech">
      <div>
        {%- if section.settings.label != blank %}<span class="lbl">{{ section.settings.label }}</span>{% endif %}
        <h2>{{ section.settings.title }}</h2>
      </div>
      <a class="more" href="{{ col.url }}">Tout voir</a>
    </div>
    <div class="cgrid center">
      {%- comment -%} Produits disponibles d'abord, ruptures de stock à la fin. {%- endcomment -%}
      {%- assign shown = 0 -%}
      {%- for product in col.products -%}
        {%- if product.available and shown < section.settings.limit -%}
          {% render 'product-card', product: product %}
          {%- assign shown = shown | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if section.settings.show_sold_out -%}
        {%- for product in col.products -%}
          {%- unless product.available or shown >= section.settings.limit -%}
            {% render 'product-card', product: product %}
            {%- assign shown = shown | plus: 1 -%}
          {%- endunless -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      <div class="btns" style="justify-content:center;margin-top:48px"><a class="btn xl" href="{{ col.url }}">{{ section.settings.button_label }} <span aria-hidden="true">→</span></a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Sélection de produits",
  "settings": [
    { "type": "text", "id": "label", "label": "Surtitre", "default": "Ma sélection" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Des objets, des histoires, des savoir-faire" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Vide = tous les produits." },
    { "type": "range", "id": "limit", "label": "Nombre maximum de produits", "min": 2, "max": 24, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "show_sold_out", "label": "Afficher les produits en rupture", "default": true },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Voir toute la boutique" }
  ],
  "presets": [{ "name": "Sélection de produits" }]
}
{% endschema %}
