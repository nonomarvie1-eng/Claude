<div class="w pg">
  <h1>{{ blog.title }}</h1>
  {%- paginate blog.articles by 12 -%}
    {%- for article in blog.articles -%}
      <article style="padding:24px 0;border-bottom:1px solid var(--line)">
        <h2 style="font-size:26px"><a href="{{ article.url }}" style="text-decoration:none">{{ article.title }}</a></h2>
        <p class="count">{{ article.published_at | date: '%d/%m/%Y' }}</p>
        <div class="rte">{{ article.excerpt_or_content | strip_html | truncatewords: 40 }}</div>
      </article>
    {%- else -%}
      <p class="empty">Aucun article pour le moment.</p>
    {%- endfor -%}
    {%- if paginate.pages > 1 -%}<div class="pag">{{ paginate | default_pagination }}</div>{%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
