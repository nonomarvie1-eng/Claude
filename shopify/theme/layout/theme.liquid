<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <link rel="canonical" href="{{ canonical_url }}">
  <title>
    {{- page_title -}}
    {%- if current_page != 1 %} – page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} – {{ shop.name }}{% endunless -%}
  </title>
  {%- if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  {%- render 'meta-tags' %}
  {%- if settings.favicon %}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
  {%- else %}
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%2317301F'/%3E%3Ctext x='32' y='44' font-family='Georgia,serif' font-size='36' font-weight='700' text-anchor='middle' fill='%23C9A15A'%3EF%3C/text%3E%3C/svg%3E">
  {%- endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Playfair+Display:wght@500;600;700&family=Pinyon+Script&display=swap" rel="stylesheet">
  <style>
    :root{color-scheme:light;
      --bg:{{ settings.color_bg }};--soft:{{ settings.color_soft }};--card:{{ settings.color_card }};--ink:{{ settings.color_ink }};--mut:{{ settings.color_mut }};--line:{{ settings.color_line }};
      --green:{{ settings.color_green }};--green2:{{ settings.color_green2 }};--gold:{{ settings.color_gold }};--goldt:{{ settings.color_goldt }};
      --d:'Playfair Display',Georgia,serif;--b:'DM Sans',system-ui,sans-serif}
  </style>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
  {{ content_for_header }}
</head>
<body class="tpl-{{ template.name }}">
  <a class="skip" href="#app">Aller au contenu</a>
  {% sections 'header-group' %}
  <main id="app" class="fade" role="main">
    {{ content_for_layout }}
  </main>
  {% sections 'footer-group' %}
  {% render 'cart-drawer' %}
  <script>
    window.FOFANA = {
      cart: {{ cart | json }},
      routes: { add: {{ routes.cart_add_url | append: '.js' | json }}, change: {{ routes.cart_change_url | append: '.js' | json }}, cart: {{ routes.cart_url | append: '.js' | json }}, checkout: '/checkout' },
      freeShipping: {% if settings.free_shipping_on %}{{ settings.free_shipping_threshold | times: 100 }}{% else %}0{% endif %},
      locale: {{ request.locale.iso_code | append: '-FR' | json }},
      currency: {{ cart.currency.iso_code | json }}
    };
  </script>
</body>
</html>
