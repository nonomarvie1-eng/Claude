<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }}</title>
  {%- if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Playfair+Display:wght@500;600;700&family=Pinyon+Script&display=swap" rel="stylesheet">
  <style>
    :root{--bg:{{ settings.color_bg }};--soft:{{ settings.color_soft }};--card:{{ settings.color_card }};--ink:{{ settings.color_ink }};--mut:{{ settings.color_mut }};--line:{{ settings.color_line }};--green:{{ settings.color_green }};--green2:{{ settings.color_green2 }};--gold:{{ settings.color_gold }};--goldt:{{ settings.color_goldt }};--d:'Playfair Display',Georgia,serif;--b:'DM Sans',system-ui,sans-serif}
  </style>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  {{ content_for_layout }}
</body>
</html>
