{%- comment -%} Carte produit (grille boutique et accueil). Paramètre : product. Tag « photo-entiere » : photo affichée en entier, sans recadrage. {%- endcomment -%}
{%- liquid
  assign first = product.featured_media
  assign second = product.media[1]
  assign cur = product.selected_or_first_available_variant.price
  assign cmp = product.selected_or_first_available_variant.compare_at_price | default: 0
  assign pos = ''
  if product.tags contains 'photo-entiere'
    assign pos = 'object-fit:contain'
  elsif first.aspect_ratio < 0.9
    assign pos = 'object-position:50% 90%'
  endif
-%}
<article class="pcard">
  <div class="pshape">
    <a class="pimg" href="{{ product.url }}" aria-label="Voir {{ product.title | escape }}" tabindex="-1">
      {%- if first -%}
        {{ first | image_url: width: 900 | image_tag: class: 'a', alt: product.title, loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 900px) 25vw, 50vw', style: pos }}
      {%- endif -%}
      {%- if second -%}
        {{ second | image_url: width: 900 | image_tag: class: 'b', alt: '', loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 900px) 25vw, 50vw', style: pos }}
      {%- endif -%}
    </a>
    {%- unless product.available %}<span class="stag">Rupture de stock</span>{% endunless -%}
    {%- if product.available and cmp > cur %}{% render 'promo-style' %}<span class="ptag">Promo</span>{% endif -%}
  </div>
  <div class="pbody">
    {%- if product.type != blank %}<span class="pcat">{{ product.type }}</span>{% endif %}
    <h3 class="pname"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    {%- if cmp > cur -%}
      <div class="pprice"><s>{{ cmp | money }}</s><span class="now">{{ cur | money }}</span></div>
    {%- else -%}
      <div class="pprice">{% if product.price_varies %}Dès {% endif %}{{ product.price_min | money }}</div>
    {%- endif -%}
    {%- if product.available == false -%}
      <a class="btn gold sm full" href="{{ product.url }}">Rupture de stock</a>
    {%- elsif product.has_only_default_variant == false -%}
      <a class="btn gold sm full" href="{{ product.url }}">Choisir</a>
    {%- else -%}
      <button class="btn gold sm full" type="button" data-add="{{ product.selected_or_first_available_variant.id }}">Ajouter au panier</button>
    {%- endif -%}
  </div>
</article>
