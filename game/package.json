{
  "name": "golden-rally",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "SINGLEFILE=1 VITE_NO_PNG_FALLBACK=1 vite build --outDir dist-single",
    "preview": "vite preview --port 4173 --strictPort",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:finalset": "VITE_GAMEPLAY=finalset vitest run",
    "test:rallypath": "VITE_GAMEPLAY=rallypath vitest run",
    "build:finalset": "VITE_GAMEPLAY=finalset vite build --outDir dist-finalset",
    "assets": "node art/build-art.mjs && node art/rasterize.mjs",
    "audio": "../math/.venv/bin/python audio/synth.py",
    "e2e": "node e2e/run-e2e.mjs"
  },
  "dependencies": {
    "@fontsource/bangers": "5.3.0",
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/inter": "5.2.5",
    "@fontsource/lilita-one": "5.3.0",
    "@fontsource/luckiest-guy": "5.3.0",
    "@fontsource/marcellus": "5.3.0",
    "@fontsource/poiret-one": "5.3.0",
    "pixi.js": "8.23.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@tsconfig/svelte": "5.0.6",
    "svelte": "5.57.3",
    "svelte-check": "4.3.4",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "3.2.7"
  }
}
