rder":"{{ settings.color_palette.foreground }}","selected_variant_style_class":"default","custom_selected_variant_background":"{{ settings.color_palette.foreground }}","custom_selected_variant_text":"{{ settings.color_palette.background }}","custom_selected_variant_border":"{{ settings.color_palette.foreground }}","alignment":"left","padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"buy_buttons_eYQEYi":{"type":"buy-buttons","settings":{"stacking":true,"text_color":"","show_pickup_availability":false,"gift_card_form":true,"recipient_button_style":"default","recipient_button_background":"{{ settings.color_palette.background }}","recipient_button_text":"{{ settings.color_palette.foreground }}","recipient_button_border":"{{ settings.color_palette.foreground }}","selected_recipient_button_style":"default","selected_recipient_button_background":"{{ settings.color_palette.foreground }}","selected_recipient_button_text":"{{ settings.color_palette.background }}","selected_recipient_button_border":"{{ settings.color_palette.foreground }}","input_style":"default","input_background_color":"{{ settings.color_palette.background }}","input_text_color":"{{ settings.color_palette.foreground }}","input_border_color":"{{ settings.color_palette.foreground }}","border_width":1,"border_radius":50,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{"quantity":{"type":"quantity","static":true,"settings":{"input_style":"default","input_background_color":"{{ settings.color_palette.background }}","input_text_color":"{{ settings.color_palette.foreground }}","input_border_color":"{{ settings.color_palette.foreground }}","border_width":1,"border_radius":50},"blocks":{}},"add-to-cart":{"type":"add-to-cart","static":true,"settings":{"style_class":"button","custom_button_background":"#e5451f","custom_button_text":"#ffffff","custom_button_border":"#e5451f"},"blocks":{}},"accelerated-checkout":{"type":"accelerated-checkout","static":true,"settings":{},"blocks":{}}},"block_order":[]},"text_aEtTtq":{"type":"text","settings":{"text":"{{ closest.product.description }}","width":"100%","max_width":"normal","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","text_color":"","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"gp_perso":{"type":"custom-liquid","settings":{"custom_liquid":"<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&family=Poppins:wght@600;700;800&display=swap\" rel=\"stylesheet\">\n{%- liquid\n  assign gp_handle = product.handle\n  assign fid = 'BuyButtons-ProductForm-' | append: section.id\n-%}\n<div class=\"gp\"><div class=\"gp-perso\" id=\"gp-perso\" data-form=\"{{ fid }}\">\n <div><h3>Personnalisez sa plaque</h3><p class=\"gp-perso__sub\">Tout se remplit ici, avant le paiement. Vous recevrez l'aperçu par e-mail avant toute impression.</p></div>\n <div class=\"gp-f\"><label for=\"gp-prenom\">Son prénom</label>\n  <input type=\"text\" id=\"gp-prenom\" name=\"properties[Prénom]\" form=\"{{ fid }}\" maxlength=\"12\" required placeholder=\"Tokyo\"><small>12 caractères maximum.</small></div>\n{%- if gp_handle contains 'petit-toutou' -%}\n <div class=\"gp-f\"><label for=\"gp-betise\">Sa plus grosse bêtise</label>\n  <input type=\"text\" id=\"gp-betise\" name=\"properties[Bêtise]\" form=\"{{ fid }}\" maxlength=\"40\" required placeholder=\"a mangé la télécommande\"><small>Elle deviendra le sous-titre du journal. 40 caractères maximum.</small></div>\n <div class=\"gp-f\"><label for=\"gp-date\">Date du journal <i>(facultatif)</i></label>\n  <input type=\"text\" id=\"gp-date\" name=\"properties[Date du journal]\" form=\"{{ fid }}\" maxlength=\"20\" placeholder=\"14 avril 2021\"><small>Son adoption, son anniversaire… Sinon, on choisit pour vous.</small></div>\n{%- elsif gp_handle contains 'avenue' -%}\n <div class=\"gp-f\"><label for=\"gp-titre\">Son titre officiel</label>\n  <input type=\"text\" id=\"gp-titre\" name=\"properties[Titre]\" form=\"{{ fid }}\" maxlength=\"25\" required placeholder=\"Chef du canapé\"><small>25 caractères maximum.</small></div>\n <div class=\"gp-f\"><label for=\"gp-annee\">Année de son arrivée</label>\n  <input type=\"text\" id=\"gp-annee\" name=\"properties[Année d'arrivée]\" form=\"{{ fid }}\" maxlength=\"4\" inputmode=\"numeric\" pattern=\"[0-9]{4}\" required placeholder=\"2021\"></div>\n{%- elsif gp_handle contains 'chateau' -%}\n <div class=\"gp-f\"><label for=\"gp-mill\">Millésime</label>\n  <input type=\"text\" id=\"gp-mill\" name=\"properties[Millésime]\" form=\"{{ fid }}\" maxlength=\"4\" inputmode=\"numeric\" pattern=\"[0-9]{4}\" required placeholder=\"2021\"><small>Son année de naissance ou d'adoption.</small></div>\n{%- elsif gp_handle contains 'pere-noel' -%}\n <div class=\"gp-f\"><label for=\"gp-voeux\">Ses 3 vœux</label>\n  <textarea id=\"gp-voeux\" name=\"properties[Vœux]\" form=\"{{ fid }}\" maxlength=\"120\" required placeholder=\"un canapé rien qu'à moi&#10;des chaussettes à voler&#10;une montagne de madeleines\"></textarea><small>Un vœu par ligne, 120 caractères au total.</small></div>\n{%- endif -%}\n <div class=\"gp-f gp-photo\"><label for=\"gp-photo\">Sa photo</label>\n  <input type=\"file\" id=\"gp-photo\" name=\"properties[Photo]\" form=\"{{ fid }}\" accept=\"image/jpeg,image/png,image/heic,image/webp\" required>\n  <ul><li>✓ Nette et bien éclairée, sans filtre</li><li>✓ La tête bien visible, de face ou de trois-quarts</li><li>✓ Une photo récente, prise au téléphone, suffit</li></ul></div>\n <div class=\"gp-f\"><label for=\"gp-note\">Une précision&nbsp;? <i>(facultatif)</i></label>\n  <input type=\"text\" id=\"gp-note\" name=\"properties[Précision]\" form=\"{{ fid }}\" maxlength=\"80\" placeholder=\"c'est un chat, collier rouge…\"></div>\n <p class=\"gp-perso__foot\">Si la photo ne permet pas un bon portrait, on vous en demande une autre avant de commencer.</p>\n</div></div>\n<script>\n(function(){var w=document.getElementById('gp-perso');if(!w)return;var id=w.dataset.form;\n if(!document.getElementById(id)){var f=document.querySelector('form[id^=\"BuyButtons-ProductForm-\"]');if(f){id=f.id;}}\n w.querySelectorAll('input,textarea').forEach(function(el){el.setAttribute('form',id);});})();\n</script>\n"},"blocks":{}},"gp_recu":{"type":"custom-liquid","settings":{"custom_liquid":"\n<div class=\"gp\"><dl class=\"gp-spec2\">\n <div><dt>La plaque</dt><dd>Aluminium imprimé, 20&nbsp;×&nbsp;30&nbsp;cm. Plaque plate&nbsp;: rivets et usure sont imprimés. Pour l'intérieur.</dd></div>\n <div><dt>L'aperçu</dt><dd>Par e-mail, sous 2 jours ouvrés après réception d'une photo exploitable. Jusqu'à 2 séries de corrections incluses. Rien n'est imprimé sans votre accord.</dd></div>\n <div><dt>Le délai</dt><dd>Environ 3&nbsp;semaines entre votre validation et la livraison. Livraison offerte en France métropolitaine, avec suivi.</dd></div>\n <div><dt>Un souci&nbsp;?</dt><dd>Plaque abîmée ou différente de l'aperçu validé&nbsp;: on la refait ou on vous rembourse.</dd></div>\n</dl></div>\n"},"blocks":{}}},"block_order":["group_icgrde","divider_VJhene","variant_picker_R3rGDr","gp_perso","buy_buttons_eYQEYi","gp_recu","text_aEtTtq"]}},"settings":{"content_width":"content-center-aligned","desktop_media_position":"left","equal_columns":false,"limit_details_width":false,"gap":48,"enable_sticky_add_to_cart":true,"background_color":"{{ settings.color_palette.background }}","padding-block-start":0,"padding-block-end":0}}},"order":["main"]}